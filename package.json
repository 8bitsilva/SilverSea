{
  "name": "silversea",
  "private": true,
  "version": "0.1.12",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "vite build && electron-builder",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish always",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0",
    "@tailwindcss/vite": "^4.2.4",
    "@xhayper/discord-rpc": "^1.5.1",
    "aria2": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "axios": "^1.16.0",
    "cheerio": "^1.2.0",
    "cross-fetch": "^4.1.0",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "postcss": "^8.5.14",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "uuid": "^14.0.0",
    "v8-compile-cache": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10",
    "vite-plugin-electron": "^0.28.0"
  },
  "build": {
    "appId": "com.silver.downloader",
    "productName": "SilverSea",
    "directories": {
      "output": "release-installer"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extensions",
        "to": "extensions"
      },
      "aria2c.exe",
      "aria2c",
      "aria2c-linux"
    ],
    "win": {
      "icon": "public/silver-sea.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "8bitsilva",
        "repo": "SilverSea",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "SilverSea-Setup.exe"
    }
  }
}
